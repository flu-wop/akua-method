<svg xmlns="http://www.w3.org/2000/svg" width="700" height="500" viewBox="0 0 700 500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4A3010"/>
      <stop offset="100%" style="stop-color:#2E1E0A"/>
    </linearGradient>
  </defs>
  <rect width="700" height="500" fill="url(#bg)"/>
  <rect width="700" height="500" fill="rgba(0,0,0,0.25)"/>
  <!-- Decorative circles -->
  <circle cx="350" cy="200" r="120" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
  <circle cx="350" cy="200" r="90" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
  <circle cx="350" cy="200" r="60" fill="rgba(255,255,255,0.06)"/>
  <!-- Icon: perfume bottle silhouette -->
  <rect x="335" y="150" width="30" height="6" rx="2" fill="rgba(255,255,255,0.4)"/>
  <rect x="327" y="156" width="46" height="75" rx="6" fill="rgba(255,255,255,0.25)" stroke="rgba(255,255,255,0.4)" stroke-width="1"/>
  <text x="350" y="310" text-anchor="middle" font-family="Georgia,serif" font-size="26" fill="#F5F1E8" letter-spacing="3">WORKSHOPS</text>
  <text x="350" y="345" text-anchor="middle" font-family="Arial,sans-serif" font-size="13" fill="#B8941E" letter-spacing="4">@AKUAMETHOD</text>
</svg>